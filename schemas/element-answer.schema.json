{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "element-answer/v1",
  "title": "element-answer/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "element_id",
    "attempt",
    "value"
  ],
  "properties": {
    "contract_version": {
      "const": "element-answer/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "element_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answer",
            "reason"
          ],
          "properties": {
            "answer": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
