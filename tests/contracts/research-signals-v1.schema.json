{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-signal-export/v1",
  "title": "Research Signal Export v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_repository",
    "source_commit",
    "purpose",
    "generated_at",
    "signal_count",
    "signals"
  ],
  "properties": {
    "contract_version": {
      "const": "research-signal-export/v1"
    },
    "source_repository": {
      "const": "self-model"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "signal_count": {
      "type": "integer",
      "minimum": 0
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/signal"
      }
    }
  },
  "$defs": {
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_ref",
        "kind",
        "layer",
        "statement",
        "certainty",
        "evidence_refs"
      ],
      "properties": {
        "entity_ref": {
          "type": "string"
        },
        "kind": {
          "enum": ["claim", "pattern"]
        },
        "layer": {
          "type": ["string", "null"]
        },
        "statement": {
          "type": ["string", "null"]
        },
        "certainty": {
          "enum": ["unknown", "low", "medium", "high"]
        },
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
